# Thimblewick: a tiny cottage garden seen at beetle size, on a warm late afternoon. A small, dainty
# waltz. F major, 3/4, 108 bpm. A soft oom-pah-pah under a music-box tune.

title Thimblewick
tempo 108
beats 3
steps 2        # 6 steps a bar
seed  173

voice pad   kind=pad       octave=4  gain=0.32  reverb=0.5
voice bass  kind=bass      octave=2  gain=0.28  reverb=0.15
voice pah   kind=harp      octave=4  gain=0.16  pan=-0.25 reverb=0.4
