# The Bazaar: a sun-baked souk under strung lights. Warm, a little exotic, never busy.
# D dorian, 84 bpm. A low drone, a soft hand drum like a slow heartbeat, an oud picking, a reed singing.

title The Bazaar
tempo 84
beats 4
steps 2
seed  23

voice drone  kind=drone  octave=2  gain=0.30  reverb=0.3
voice pad    kind=pad    octave=4  gain=0.28  reverb=0.55
voice drum   kind=drum   octave=2  gain=0.30  reverb=0.2
voice oud    kind=koto   octave=3  gain=0.26  pan=-0.25 reverb=0.4
voice reed   kind=reed   octave=5  gain=0.28  pan=0.2   reverb=0.45

