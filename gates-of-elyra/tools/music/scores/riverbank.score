# The Riverbank: a gentle stream, stones and driftwood. Flowing, unhurried, a little bright.
# G major, 76 bpm. A harp ripples like moving water; a wooden flute wanders over it.

title The Riverbank
tempo 76
beats 4
steps 2
seed  11

voice pad    kind=pad    octave=4  gain=0.45  reverb=0.6
voice bass   kind=bass   octave=2  gain=0.28  reverb=0.15
voice harp   kind=harp   octave=4  gain=0.22  pan=-0.3  reverb=0.5
voice flute  kind=flute  octave=5  gain=0.32  pan=0.2   reverb=0.55
voice sky    kind=chime  octave=6  gain=0.30  pan=0.3   spread=0.5 reverb=0.8

