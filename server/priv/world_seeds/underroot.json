	"props": [
		{"id": "rootfall_stone", "type": "ur_stone", "position": [-70, 780], "color": [1.0, 1.0, 1.0], "label": "a flat stone with scratches on it", "interactive": true, "lore": "Letters have been scratched into a flat stone, by someone patient. 'To whoever comes down: do not hurry. The dark here is not hungry, only large. Let your companion go first, and follow its light.' Below, smaller: 'It knows the way better than you do. Tap it, and ask it to Go look.'", "solid": true, "collision_radius": 8},
		{"id": "rootfall_moss_a", "type": "ur_glowmoss", "position": [60, 790], "color": [0.46, 0.96, 0.78], "label": "a patch of glow-moss"},
		{"id": "rootfall_moss_b", "type": "ur_glowmoss", "position": [-120, 700], "color": [0.46, 0.96, 0.78], "label": "a patch of glow-moss"},
		{"id": "rootfall_moss_c", "type": "ur_glowmoss", "position": [110, 850], "color": [1.0, 0.82, 0.46], "label": "a patch of glow-moss"},
		{"id": "rootfall_caps", "type": "ur_glowcap", "position": [130, 740], "color": [0.78, 0.62, 1.0], "label": "a few glowcaps"},
		{"id": "rootfall_sprout", "type": "ur_sprout", "position": [-130, 760], "color": [1.0, 0.82, 0.46], "label": "a pale seedling", "interactive": true, "lore": "A pale seedling, no taller than your hand, has come up out of the loam and leaned itself, with great effort, toward the way you came in. It is leaning toward a light that is a very long way up. Its tip glows, a little, in case that helps.", "solid": false},
		{"id": "tangle_lantern", "type": "ur_lantern", "position": [-100, 10], "color": [1.0, 1.0, 1.0], "label": "an old iron lantern", "interactive": true, "lore": "An iron lantern, long cold, set down neatly on the floor. Someone came this way once with a light of their own, and put it down, and went on without it. You like to think they didn't need it any more."},
		{"id": "tangle_knot", "type": "ur_rootknot", "position": [120, -96], "color": [1.0, 1.0, 1.0], "label": "a knot of root", "interactive": true, "lore": "A root as thick as your waist has tied itself into a knot, perhaps to see what that was like. It looks pleased with the result.", "solid": true, "collision_radius": 9},
		{"id": "garden_cap_a", "type": "ur_glowcap", "position": [-986, 20], "color": [0.78, 0.62, 1.0], "label": "glowcaps", "interactive": true, "lore": "Pale caps, glowing the colour of a thought you almost had. They sway, though nothing here is moving. Your companion's nose twitches at them and then, politely, at nothing.", "solid": false},
		{"id": "pools_drip", "type": "ur_drip", "position": [-812, 460], "color": [1.0, 1.0, 1.0], "label": "a dripping stone", "interactive": true, "lore": "Drip. Pause. Drip. A single bright drop falls from the dark above onto a stone that has been worn into a bowl by exactly this. You count to eleven between drops, and then lose your place, happily.", "solid": true, "collision_radius": 6},
		{"id": "drip_door", "type": "ur_door", "position": [-90, -458], "color": [1.0, 1.0, 1.0], "label": "a very small door", "interactive": true, "lore": "A very small round door, set into the side of a root, with a brass knob and one worn step. Someone small lives here. They are, you suspect, out, and would like you to keep it quiet that they leave the door unlocked.", "solid": true, "collision_radius": 8},
		{"id": "lantern_room_lantern", "type": "ur_lantern", "position": [950, -706], "color": [1.0, 1.0, 1.0], "label": "a second cold lantern", "interactive": true, "lore": "Another cold lantern, and beside it a folded blanket, and beside that a cup with a little water in it. Whoever sat here sat for a long time, in the dark, being quite all right."},
		{"id": "lantern_room_sprout", "type": "ur_sprout", "position": [860, -590], "color": [0.46, 0.96, 0.78], "label": "a pale seedling", "interactive": true, "lore": "A seedling, very pale, leaning toward the lantern as if it might, one day, light. It is not discouraged."},
		{"id": "stair_door", "type": "ur_door", "position": [830, 22], "color": [1.0, 1.0, 1.0], "label": "a small door, with a smaller one beside it", "interactive": true, "lore": "A tiny door. Beside it, an even tinier one. You step back, and decide that the whole of Underroot is probably full of doors, and you are simply too large to see most of them.", "solid": true, "collision_radius": 8},
		{"id": "stair_knot", "type": "ur_rootknot", "position": [1062, 130], "color": [1.0, 1.0, 1.0], "label": "a stair of roots", "interactive": true, "lore": "The roots here have grown into steps, going up into a ceiling that is not there. They end after four. Your companion sits on the top one and looks quite proud of itself.", "solid": true, "collision_radius": 9},
		{"id": "cairn_a", "type": "ur_cairn", "position": [850, 630], "color": [1.0, 1.0, 1.0], "label": "a little cairn", "interactive": true, "lore": "A little stack of pebbles, three high, set on a flat stone. Travellers leave them for company. You add one of your own, and the stack does not fall.", "solid": false},
		{"id": "cairn_b", "type": "ur_cairn", "position": [1060, 500], "color": [1.0, 1.0, 1.0], "label": "a little cairn", "interactive": true, "lore": "Another cairn, older, mossed over at the bottom. There is a very small footprint in the clay beside it, going in the same direction as yours.", "solid": false},
		{"id": "cairn_c", "type": "ur_cairn", "position": [744, 720], "color": [1.0, 1.0, 1.0], "label": "a cairn of two", "interactive": true, "lore": "Two pebbles, one on the other. Someone didn't have more, and wanted to mark the place anyway. It is somehow the best cairn in the cave.", "solid": false},
		{"id": "heartwood_knot", "type": "ur_rootknot", "position": [-1090, -600], "color": [1.0, 1.0, 1.0], "label": "the roots round the Heartwood", "interactive": true, "lore": "The roots grow close and low round this chamber, curving in toward the middle the way a hand curls round something small. The whole room is leaning in on it.", "solid": true, "collision_radius": 9},
