	"props": [
		{"id": "keep_stones", "type": "hz_examine", "position": [40, -1880], "color": [0.72, 0.7, 0.66], "label": "the old keep", "interactive": true, "lore": "A round keep, its top long gone. The stones are warm on the sunny side and cool on the other. You can see the whole road from here, and the place you started is too small to make out.", "solid": true, "collision_radius": 34},
		{"id": "fingerpost", "type": "hz_examine", "position": [70, 1080], "color": [0.72, 0.7, 0.66], "label": "a fingerpost", "interactive": true, "lore": "One arm points up the road: KEEP. The other points back the way you came, and the word on it has worn away. Somebody kept painting the first one."},
		{"id": "mill_east", "type": "hz_examine", "position": [1040, -330], "color": [0.72, 0.7, 0.66], "label": "a windmill", "interactive": true, "lore": "Its sails turn when nobody is looking. Flour dust lies on the step, and a cat-sized door is propped open with a stone."},
		{"id": "mill_west", "type": "hz_examine", "position": [-1180, 760], "color": [0.72, 0.7, 0.66], "label": "a windmill", "interactive": true, "lore": "The oldest of the mills. Somebody has carved the date into the door frame, then scratched it out, as if it was nobody's business how old it was."},
		{"id": "millpond_stone", "type": "rock", "position": [-640, -230], "color": [0.72, 0.7, 0.66], "label": "a flat stone by the pond", "interactive": true, "lore": "A flat stone at the water's edge, worn smooth by people sitting just here. The pond holds the whole sky, and a fish now and then.", "solid": true, "collision_radius": 9},
		{"id": "road_milestone", "type": "rock", "position": [-60, 300], "color": [0.72, 0.7, 0.66], "label": "a milestone", "interactive": true, "lore": "A milestone. The number on it is half a mile less than the last one, but you don't remember passing the last one.", "solid": true, "collision_radius": 7},
