	"_secret_comment": "This world's one SECRET (docs/home-world-and-secrets-design.md, 'Loftreach'). reveal.type 'skyview': shift the companion into a bird (reveal.species) and tell it to Go up; the camera rises with it and, from the 'vantage', the high clouds ('sky.picture') show an arrow toward the nest. When the bird has looked at every one of 'targets' from high enough for 'see_secs' (SkyView), the hidden bridge 'bridge' (sky.bridges) appears and can be walked to the nest, which is the secret's prop. The server honours a claim only here, within 'radius' of 'position'.",
	"secret": {
		"id": "sky_nest",
		"position": [
			1408,
			-694
		],
		"radius": 130.0,
		"prop": {
			"type": "lr_nest",
			"color": [
				0.86,
				0.72,
				0.46
			],
			"label": "a nest",
			"tags": [
				"woven",
				"high",
				"warm",
				"quiet"
			]
		},
		"lore": "A nest, woven from rope-ends, wind-flowers and feathers, and warm as if someone has only just left it. In it, one pale egg, with a faint blue light in the shell, and a single feather laid across it like a letter.",
		"reveal": {
			"type": "skyview",
			"species": "bird",
			"bridge": "sky_bridge",
			"vantage": [
				755,
				-565
			],
			"targets": [
				[
					1408,
					-694
				],
				[
					891,
					-506
				]
			],
			"head": [
				891,
				-506
			],
			"rise_secs": 1.6,
			"fly_speed": 1100.0,
			"travel_min": 0.9,
			"travel_max": 3.0,
			"stay_low": 5.0,
			"stay_high": 10.0,
			"hold_add": 3.0,
			"stay_cap": 20.0,
			"descend_secs": 1.5,
			"min_flight": 0.7,
			"zoom_low": 0.38,
			"zoom_high": 0.3,
			"bird_lift": 220.0,
			"see_alt": 0.72,
			"see_secs": 1.2,
			"view_margin": 30.0,
			"picture_from": 0.35,
			"picture_to": 0.8,
			"reveal_secs": 3.0,
			"after_reveal_stay": 2.2,
			"notice_range_low": 780.0,
			"notice_range_high": 1250.0,
			"notice_cooldown_low": 18.0,
			"notice_cooldown_high": 8.0,
			"notice_hold": 2.5,
			"look_back_secs": 3.0,
			"lines": {
				"notice": "Your companion stops at the edge and stares out across the sky at something you cannot see.",
				"not_bird": "Only a bird can climb that high. Shift your companion into its Bird shape, then tell it to Go up.",
				"launch": "Your companion's wings open, and it lifts off, and the whole sky tips up to meet you.",
				"picture": "From up here the clouds are not scattered. They lie in a line, and they have a point.",
