	"props": [
		{"id": "landing_sign", "type": "lr_sign", "position": [-1260, 830], "color": [1.0, 1.0, 1.0], "label": "a signpost", "interactive": true, "lore": "Carved on a signpost, in a hurry: 'Mind the edge. The sky has no handrail. Everything up here leans one way, toward the same far thing. 'Watch the vanes.'", "solid": true, "collision_radius": 6},
		{"id": "landing_bench", "type": "lr_bench", "position": [-1330, 670], "color": [1.0, 1.0, 1.0], "label": "a bench", "interactive": true, "lore": "A bench facing nothing but sky. It is the best view on the island, and somebody has worn the paint off the middle.", "solid": true, "collision_radius": 10},
		{"id": "landing_planter", "type": "lr_planter", "position": [-1210, 720], "color": [1.0, 1.0, 1.0], "label": "a planter", "interactive": true, "lore": "Windflowers, in a box, on a rock, in the sky. They are doing very well."},
		{"id": "landing_lamp", "type": "lr_lamp", "position": [-1190, 800], "color": [1.0, 1.0, 1.0], "label": "a lamp", "interactive": true, "lore": "A lamp on a post. By dusk it is the only thing for a mile that is not either a cloud or a hill.", "solid": true, "collision_radius": 5},
		{"id": "landing_barrel", "type": "lr_barrel", "position": [-1410, 830], "color": [1.0, 1.0, 1.0], "label": "a barrel", "interactive": true, "lore": "Empty, and it rings when you tap it, which carries a long way up here.", "solid": true, "collision_radius": 7},
		{"id": "mill", "type": "lr_windmill", "position": [-520, 540], "color": [1.0, 1.0, 1.0], "label": "the windmill", "interactive": true, "lore": "The sails turn without any hurry. The miller is not in; the grain is, in the form of sacks, and every one is labelled 'for the clouds'.", "solid": true, "collision_radius": 22},
		{"id": "mill_hay_a", "type": "lr_haystack", "position": [-710, 620], "color": [1.0, 1.0, 1.0], "label": "a haystack", "interactive": true, "lore": "Warm, and it smells of a summer that is on some other island.", "solid": true, "collision_radius": 11},
		{"id": "mill_hay_b", "type": "lr_haystack", "position": [-700, 690], "color": [1.0, 1.0, 1.0], "label": "another haystack", "interactive": true, "lore": "A haystack. A very good one to lie against and look up."},
		{"id": "mill_bench", "type": "lr_bench", "position": [-430, 650], "color": [1.0, 1.0, 1.0], "label": "a bench", "interactive": true, "lore": "A bench set so that you face the sails. Watching them turn is what it is for.", "solid": true, "collision_radius": 10},
		{"id": "mill_sign", "type": "lr_sign", "position": [-630, 690], "color": [1.0, 1.0, 1.0], "label": "a signpost", "interactive": true, "lore": "'Millstone Lea. Flour by wind. The wind is the only thing here that works for free, and it knows.'", "solid": true, "collision_radius": 6},
		{"id": "mill_barrel", "type": "lr_barrel", "position": [-470, 480], "color": [1.0, 1.0, 1.0], "label": "a barrel", "interactive": true, "lore": "Full. Of what, nobody has ever asked.", "solid": true, "collision_radius": 7},
		{"id": "kite_stake_a", "type": "lr_kite_stake", "position": [150, 750], "color": [1.0, 1.0, 1.0], "label": "a kite stake", "interactive": true, "lore": "A stake with a spool of line. The line goes up and does not come back down for a good long while."},
		{"id": "kite_stake_b", "type": "lr_kite_stake", "position": [270, 670], "color": [1.0, 1.0, 1.0], "label": "a kite stake", "interactive": true, "lore": "The line from this one is tied in a knot that says someone meant it."},
		{"id": "kite_stake_c", "type": "lr_kite_stake", "position": [340, 800], "color": [1.0, 1.0, 1.0], "label": "a kite stake", "interactive": true, "lore": "The line is taut, and sings."},
		{"id": "kite_stake_d", "type": "lr_kite_stake", "position": [220, 870], "color": [1.0, 1.0, 1.0], "label": "a kite stake", "interactive": true, "lore": "A little kite on a short string, for beginners, who are also kites."},
		{"id": "kite_hammock", "type": "lr_hammock", "position": [100, 890], "color": [1.0, 1.0, 1.0], "label": "a hammock", "interactive": true, "lore": "Slung between two posts, over the long drop. People sleep here. It is, they say, better than the ground."},
		{"id": "kite_pennant", "type": "lr_pennant", "position": [380, 700], "color": [1.0, 1.0, 1.0], "label": "a string of pennants", "interactive": true, "lore": "Bunting, snapping in the wind like a lot of small, bright applause."},
		{"id": "kite_sign", "type": "lr_sign", "position": [250, 810], "color": [1.0, 1.0, 1.0], "label": "a signpost", "interactive": true, "lore": "'Kite Green. All kites are welcome. Kites are tied to the ground, mostly for their own good.'", "solid": true, "collision_radius": 6},
		{"id": "orchard_bench", "type": "lr_bench", "position": [-1270, 160], "color": [1.0, 1.0, 1.0], "label": "a bench", "interactive": true, "lore": "A bench under blossom. Petals fall on it, and nobody sweeps them off, for good reason.", "solid": true, "collision_radius": 10},
		{"id": "orchard_planter", "type": "lr_planter", "position": [-1170, 60], "color": [1.0, 1.0, 1.0], "label": "a planter", "interactive": true, "lore": "Poppies, windflowers, buttercups. It is the sky's own idea of a bouquet."},
		{"id": "orchard_sign", "type": "lr_sign", "position": [-1230, 240], "color": [1.0, 1.0, 1.0], "label": "a signpost", "interactive": true, "lore": "'Cloud Orchard. Pick what you like. The apples taste of rain; that is the cloud in them.'", "solid": true, "collision_radius": 6},
		{"id": "vane_a", "type": "lr_vane", "position": [-250, -260], "color": [1.0, 1.0, 1.0], "label": "a weathervane", "interactive": true, "lore": "A weathervane. Wind from the south, the west, the south again; it does not matter. The arrow points, firmly, up and to the right.", "solid": true, "collision_radius": 5},
		{"id": "vane_b", "type": "lr_vane", "position": [-380, -160], "color": [1.0, 1.0, 1.0], "label": "another weathervane", "interactive": true, "lore": "This vane points up and to the right as well. Whatever it is pointing at, it has been pointing at it for a long time.", "solid": true, "collision_radius": 5},
		{"id": "vane_c", "type": "lr_vane", "position": [-130, -170], "color": [1.0, 1.0, 1.0], "label": "a third weathervane", "interactive": true, "lore": "A third vane, in complete agreement with the other two. Somebody has painted 'FAR' on its post, and underlined it.", "solid": true, "collision_radius": 5},
		{"id": "vane_stone", "type": "lr_standing_stone", "position": [-210, -80], "color": [1.0, 1.0, 1.0], "label": "a standing stone", "interactive": true, "lore": "A bird, scratched into the stone, wings up, looking out over the edge. Under it, smaller: 'what the clouds draw, only a bird can read'.", "solid": true, "collision_radius": 8},
		{"id": "pennant_stone", "type": "lr_standing_stone", "position": [500, -280], "color": [1.0, 1.0, 1.0], "label": "a standing stone", "interactive": true, "lore": "Another bird scratched into a stone, and this time a line, from its beak out across the sky. It stops at the edge of the stone, but not of the idea.", "solid": true, "collision_radius": 8},
		{"id": "pennant_flag_a", "type": "lr_pennant", "position": [440, -440], "color": [1.0, 1.0, 1.0], "label": "a flag pole", "interactive": true, "lore": "Bunting. It all streams one way, and it is the same way as the vanes."},
		{"id": "pennant_boulder_a", "type": "lr_boulder", "position": [420, -340], "color": [1.0, 1.0, 1.0], "label": "a mossy boulder", "interactive": true, "lore": "A boulder with moss on the side the wind does not reach."},
		{"id": "pasture_perch", "type": "lr_perch", "position": [920, 320], "color": [1.0, 1.0, 1.0], "label": "a dovecote", "interactive": true, "lore": "A dovecote on a post. The doves are out. They come and go over the edge, which no one can quite see the point of, and then they are back."},
		{"id": "pasture_hay", "type": "lr_haystack", "position": [1060, 420], "color": [1.0, 1.0, 1.0], "label": "a haystack", "interactive": true, "lore": "A haystack the size of a small hill, with a small hill's confidence.", "solid": true, "collision_radius": 11},
		{"id": "pasture_bench", "type": "lr_bench", "position": [960, 470], "color": [1.0, 1.0, 1.0], "label": "a bench", "interactive": true, "lore": "A bench for lantern-watching.", "solid": true, "collision_radius": 10},
		{"id": "perch_dove_a", "type": "lr_perch", "position": [-560, -940], "color": [1.0, 1.0, 1.0], "label": "a dovecote", "interactive": true, "lore": "Empty. The doves say the view from here is no good, and they have somewhere better to be.", "solid": true, "collision_radius": 6},
		{"id": "perch_dove_b", "type": "lr_perch", "position": [-410, -910], "color": [1.0, 1.0, 1.0], "label": "a dovecote", "interactive": true, "lore": "A dovecote with feathers all round the door. They are not discarded. They have been arranged.", "solid": true, "collision_radius": 6},
		{"id": "perch_stone", "type": "lr_standing_stone", "position": [-480, -1040], "color": [1.0, 1.0, 1.0], "label": "a standing stone", "interactive": true, "lore": "A bird again, and this one has something under its wings: a line of tiny clouds, all pointing the same way. 'Ask the one who flies. Shift it to a bird, and tell it to go up.'", "solid": true, "collision_radius": 8},
		{"id": "perch_vane", "type": "lr_vane", "position": [-370, -990], "color": [1.0, 1.0, 1.0], "label": "a weathervane", "interactive": true, "lore": "Up and to the right. Always.", "solid": true, "collision_radius": 5},
		{"id": "rookery_boulder", "type": "lr_boulder", "position": [1340, -660], "color": [1.0, 1.0, 1.0], "label": "a boulder", "interactive": true, "lore": "A boulder, a good long way from anywhere you could have walked to.", "solid": true, "collision_radius": 8},
		{"id": "pasture_lamp_0", "type": "lr_lamp", "position": [850, 370], "color": [1.0, 1.0, 1.0], "label": "a lamp", "interactive": true, "lore": "A lamp on a post, lit even in daylight, for the thought.", "solid": true, "collision_radius": 5},
