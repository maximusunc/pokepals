# The Ruin: old stone, wards, a descent. Mysterious and patient, but never threatening.
# A aeolian, 60 bpm. A drone under everything, a far singing bowl, a glass tune that blooms slowly.

title The Ruin
tempo 60
beats 4
steps 2
seed  31

voice drone  kind=drone  octave=1  gain=0.32  reverb=0.4
voice pad    kind=pad    octave=4  gain=0.36  reverb=0.7
voice bowl   kind=bowl   octave=3  gain=0.30  pan=-0.2 reverb=0.75
voice glass  kind=glass  octave=5  gain=0.30  pan=0.15 reverb=0.7
voice sky    kind=chime  octave=6  gain=0.26  spread=0.6 reverb=0.85

[intro]
chords | Am | Fmaj7 | Am | Em |
drone  | A1 - - - - - - - | - - - - - - - - | - - - - - - - - | - - - - - - - - |
pad    | * - - - - - - - |
bowl   | A3 - - - - - - - | . . . . . . . . | . . . . . . . . | . . . . . . . . |

[a]
chords | Am | Fmaj7 | Am | Em | Dm7 | Fmaj7 | G | Esus4 E |
drone  | A1 - - - - - - - | - - - - - - - - | - - - - - - - - | - - - - - - - - | - - - - - - - - | - - - - - - - - | - - - - - - - - | - - - - - - - - |
pad    | * - - - - - - - |
glass  | E5 - - - - - D5 - | C5 - - - - - - - | E5 - - - A5 - - - | G5 - - - - - - - | F5 - - - E5 - - - | C5 - - - A4 - - - | B4 - - - D5 - - - | B4 - - - G#4 - - - |

[b]
chords | Fmaj7 | G | Am | Am | Fmaj7 | G | Esus4 | E |
drone  | A1 - - - - - - - | - - - - - - - - | - - - - - - - - | - - - - - - - - | - - - - - - - - | - - - - - - - - | - - - - - - - - | - - - - - - - - |
pad    | * - - - - - - - |
bowl   | F3 - - - - - - - | . . . . . . . . | . . . . . . . . | . . . . . . . . | E3 - - - - - - - | . . . . . . . . | . . . . . . . . | . . . . . . . . |
sky    | . . . . . . . . | . . . . B6 - . . | . . . . . . . . | . . E6 - . . . . | . . . . . . . . | . . . . . . D6 - | . . . . . . . . | . . . . . . . . |

play intro a b a
