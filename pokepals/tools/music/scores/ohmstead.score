# Ohmstead: the machine behind the Gateway. A grid of light in the dark, and something patiently ticking over.
# A minor, 100 bpm. A soft sequencer line (a tine, and its fainter echo an octave up) ticks through each
# chord, a round bass holds the root, a pad fills the dark, and a glass tone sings slowly over the top.
# No drums and nothing sharp: an arcade heard from the next room.

title Ohmstead
tempo 100
beats 4
steps 2
seed  157

voice pad   kind=pad       octave=4  gain=0.40  reverb=0.6
voice bass  kind=bass      octave=2  gain=0.40  reverb=0.2
voice seq   kind=musicbox  octave=4  gain=0.26  pan=-0.2  reverb=0.35
voice echo  kind=musicbox  octave=5  gain=0.12  pan=0.35  reverb=0.6  delay=3
voice lead  kind=glass     octave=5  gain=0.26  pan=0.1   reverb=0.7
voice sky   kind=chime     octave=6  gain=0.22  spread=0.7 reverb=0.85

[intro]
chords | Am7 | Fmaj7 | Am7 | Fmaj7 |
pad    | * - - - - - - - |
seq    | 1 . 3 . 2 . 3 . |

[a]
chords | Am7 | Fmaj7 | C | G | Am7 | Fmaj7 | C | Esus4 |
pad    | * - - - - - - - |
bass   | 1 - - - - - 1 - |
seq    | 1 2 3 2 1' 2 3 2 |
echo   | 1 . . . 3 . . . |
lead   | E5 - - - - - C5 - | A5 - - - - - G5 - | E5 - - - G5 - - - | D5 - - - - - - - | C5 - - - E5 - - - | A5 - - - - - C6 - | G5 - - - E5 - - - | E5 - - - - - . . |

[b]
chords | Dm7 | Am7 | Fmaj7 | G | Dm7 | Am7 | Fmaj7 | Esus4 |
pad    | * - - - - - - - |
bass   | 1 - - - 1 - - - |
seq    | 1 3 2 3 1' 3 2 3 |
echo   | 3 . . . 1 . . . |
lead   | F5 - - - A5 - - - | E5 - - - - - C5 - | A5 - - - - - F5 - | G5 - - - D5 - - - | F5 - - - D5 - - - | E5 - - - - - A5 - | C6 - - - A5 - - - | B5 - - - - - . . |
sky    | . . . . . . . . | . . . . E6 - . . | . . . . . . . . | . . . . . . D6 - | . . . . . . . . | . . . . . . . . | . . E6 - . . . . | . . . . . . . . |

[c]
chords | Fmaj7 | G | Am7 | Am7 | Fmaj7 | G | C | Esus4 |
pad    | * - - - - - - - |
bass   | 1 - - - - - - - |
seq    | 1 . . . 3 . . . |
sky    | . . . . A6 - . . | . . . . . . . . | . . E6 - . . . . | . . . . . . C6 - | . . . . . . . . | . . D6 - . . . . | . . . . . . G6 - | . . . . . . . . |

play intro a b a c b
