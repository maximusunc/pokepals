[b]
chords | Gmaj7 | F#m7 | Em9 | Dmaj7 | Bm9 | Gmaj7 | Em9 | A7sus4 |
hum    | * - - - - - - - |
bass   | 1 - - - - - - - |
keys   | . . 2 . . 3 . 4 |
bell   | . . B5 - - - A5 - | F#5 - - - - - . . | . . G5 - F#5 - E5 - | F#5 - - - - - - - | . . D5 - - - E5 - | F#5 - - - A5 - - - | G5 - - - - - . . | E5 - - - - - . . |

