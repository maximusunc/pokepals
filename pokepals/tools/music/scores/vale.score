bell   | A4 - - C5 - - F5 - | G5 - - - E5 - C5 - | D5 - - C5 - - A4 - | G4 - - - - - . . |

[b]
chords | Dm7 | Bbmaj7 | F | C | Dm7 | Bbmaj7 | Gm7 | Csus4 C |
pad    | * - - - - - - - |
bass   | 1 - - - 3 - 1 - |
harp   | 1 3 2 4 3 . 2 . |
bell   | F5 - E5 - D5 - - - | D5 - C5 - - - A4 - | C5 - - A4 - - F4 - | G4 - - - - - . . | F5 - E5 - D5 - A5 - | G5 - - F5 - - D5 - | F5 - - E5 - - D5 - | F5 - - E5 - - . . |
