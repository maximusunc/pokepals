	"props": [
		{"id": "margin_sign", "type": "signpost", "position": [70, 880], "color": [1.0, 1.0, 1.0], "label": "a signpost", "interactive": true, "lore": "It says: GLYPHFALL. Under that, smaller: \"written down so that it would keep.\" Under that, smaller still, something crossed out.", "solid": true, "collision_radius": 5},
		{"id": "margin_bench", "type": "bench", "position": [-150, 800], "color": [1.0, 1.0, 1.0], "label": "a bench", "interactive": true, "lore": "The word for a bench, and so, a bench. It holds your weight, which seems generous of a word."},
		{"id": "margin_flowers", "type": "wildflowers", "position": [150, 760], "color": [0.96, 0.52, 0.72], "label": "some flowers", "interactive": true, "lore": "Asterisks, mostly. Whoever wrote this place down could not draw a flower and did not let that stop them."},
		{"id": "sentence_stone", "type": "chime_stone", "position": [-300, 70], "color": [0.74, 0.6, 0.96], "label": "a ringing stone", "interactive": true, "lore": "Touch it and it sounds one clear note, the way a full stop sounds if you read aloud."},
		{"id": "sentence_lamp", "type": "lantern", "position": [300, 80], "color": [0.98, 0.84, 0.36], "label": "a lamp", "interactive": true, "lore": "A lamp left by the path, so the sentence can be read after dark. It is never dark here. The lamp was left anyway.", "solid": true, "collision_radius": 5},
		{"id": "sentence_board", "type": "notice_board", "position": [-560, 60], "color": [1.0, 1.0, 1.0], "label": "a board of notes", "interactive": true, "lore": "Notes to self, pinned up. \"More birds.\" \"Is the water too blue?\" \"Leave room at the end.\"", "solid": true, "collision_radius": 8},
		{"id": "inkwell_basin", "type": "basin", "position": [-760, 560], "color": [1.0, 1.0, 1.0], "label": "a stone bowl", "interactive": true, "lore": "A bowl to wash a pen in. The water in it is the same water as the Inkwell, which is to say it is mostly the word 'water', and very clear."},
		{"id": "inkwell_log", "type": "log", "position": [-1300, 960], "color": [1.0, 1.0, 1.0], "label": "a fallen log", "interactive": true, "lore": "\"A log lay by the water.\" That is all it says about it, and the log has been lying by the water ever since."},
		{"id": "wood_pillar", "type": "broken_pillar", "position": [-1080, -520], "color": [1.0, 1.0, 1.0], "label": "a broken column", "interactive": true, "lore": "The only thing here that was crossed out and then let stay. You can still see the line through it.", "solid": true, "collision_radius": 7},
		{"id": "wood_mushrooms", "type": "mushrooms", "position": [-820, -300], "color": [1.0, 1.0, 1.0], "label": "mushrooms", "interactive": true, "lore": "They grow in the gaps between paragraphs, where nobody was looking when they wrote."},
		{"id": "heading_carving", "type": "carving", "position": [0, -760], "color": [1.0, 1.0, 1.0], "label": "a carved stone", "interactive": true, "lore": "The title, cut into stone at the top of everything. The letters are worn too soft to read. You can tell it was short, and that somebody liked it.", "solid": true, "collision_radius": 8},
		{"id": "heading_crystal", "type": "crystal", "position": [-120, -420], "color": [0.74, 0.6, 0.96], "label": "a clear crystal", "interactive": true, "lore": "Hold it up and everything behind it turns into small neat letters. Put it down and everything stays that way."},
		{"id": "footnote_berries", "type": "berry_bush", "position": [1060, 940], "color": [0.86, 0.3, 0.4], "label": "a berry bush", "interactive": true, "lore": "A footnote says the berries are sweet. A footnote to the footnote says: in summer. It is always summer."},
		{"id": "footnote_crate", "type": "crate", "position": [760, 1040], "color": [1.0, 1.0, 1.0], "label": "a crate", "interactive": true, "lore": "A crate of spare punctuation. Mostly commas. A world like this gets through a great many commas.", "solid": true, "collision_radius": 7},
		{"id": "unwritten_end", "type": "rubble_pile", "position": [886, -418], "color": [1.0, 1.0, 1.0], "label": "the end of the path", "interactive": true, "lore": "The path stops here, in the middle of a thought. Beyond it there is only grass, and whatever the writer meant to say next."},
		{"id": "unwritten_column", "type": "column", "position": [1360, -980], "color": [1.0, 1.0, 1.0], "label": "a lone column", "interactive": true, "lore": "One column, holding up nothing yet. There was going to be more here. There is room for it.", "solid": true, "collision_radius": 7},
