		{"id": "wishing_fountain", "type": "ll_fountain", "position": [0, 240], "color": [0.965, 0.937, 0.902], "label": "the wishing fountain", "tags": ["water", "old", "wishes"], "interactive": true, "lore": "The wishing fountain. The water is warm and very clear, and the bottom of the basin glitters with coins from everywhere. It remembers every wish. It has never told anyone a single one.", "solid": false},
