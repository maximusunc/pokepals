		{"id": "brass_plaque", "type": "ll_plaque", "position": [0, 392], "color": [0.914, 0.769, 0.416], "label": "a brass plaque", "tags": ["brass", "words"], "interactive": true, "lore": "A brass plaque, polished by a great many thumbs. It says: 'LINGERLONG. Built as the place to meet. Five doors, and every one of them leads here. One of them leads here later.'", "solid": true, "collision_radius": 6},
		{"id": "bust_c", "type": "ll_bust_lore", "position": [1040, 412], "color": [0.965, 0.937, 0.902], "label": "a bust: Someone's Friend", "tags": ["statue", "old"], "interactive": true, "lore": "SOMEONE'S FRIEND. A scarf, a kind face. Not anybody's friend in particular. Everybody has one of these, and the plaza thought they deserved a statue.", "solid": false},
