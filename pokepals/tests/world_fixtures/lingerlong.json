		{"id": "palm_court_sign", "type": "ll_plaque", "position": [-1000, 300], "color": [0.914, 0.769, 0.416], "label": "a little brass sign", "interactive": true, "lore": "THE PALM COURT. 'Please take your time.' Underneath, smaller: 'You can't not, here.'", "solid": true, "collision_radius": 6},
