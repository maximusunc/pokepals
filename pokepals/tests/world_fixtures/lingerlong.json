		{"id": "bust_a", "type": "ll_bust_lore", "position": [1040, 172], "color": [0.965, 0.937, 0.902], "label": "a bust: The First to Arrive", "tags": ["statue", "old"], "interactive": true, "lore": "THE FIRST TO ARRIVE, says the plinth. A calm face with a laurel. Early, and not the least bit smug about it. It has been keeping an eye on the door for everyone else.", "solid": false},
		{"id": "bust_b", "type": "ll_bust_lore", "position": [1240, 172], "color": [0.965, 0.937, 0.902], "label": "a bust: Whoever Waved Back", "tags": ["statue", "old"], "interactive": true, "lore": "WHOEVER WAVED BACK. A face under a sun hat, eyes closed, mid-smile. You waved at someone across a square once, and they waved back, and neither of you ever found out who the other was. This is them. Or it's you.", "solid": false},
		{"id": "palm_lounger_1w", "type": "ll_lounger", "position": [-1202, 180], "color": [0.949, 0.608, 0.71], "label": "a lounger", "interactive": true, "lore": "A lounger under a pink parasol. It is exactly the right amount of shade.", "solid": false},
